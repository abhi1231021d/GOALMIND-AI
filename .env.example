# ==============================================================================
# GoalMind AI — Environment Configuration Template
# ==============================================================================

# Database Configuration (MySQL 8.0)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=goalmind_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Security
# Ensure the secret is at least 256 bits (32+ characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Server Port
SERVER_PORT=8080

# AI Provider Configuration (Optional)
# If left blank, GoalMind AI will automatically use its internal deterministic
# rule-based reasoning engine for roadmaps, diagnostics, and recovery plans.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Frontend (Vite)
VITE_API_URL=http://localhost:8080/api
